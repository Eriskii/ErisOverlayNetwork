         (see values-night) and keeps force-dark from inverting what is already themed. -->
    <style name="Theme.ErisOverlayNetwork" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
