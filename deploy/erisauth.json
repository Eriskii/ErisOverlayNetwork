{
  "protocol": 1,
  "name": "erisauth",
  "description": "Approvals beyond a device's own authority, when the person gives the passphrase",
  "executable": "/usr/local/libexec/erisdb/erisdb-plugin-erisauth",
  "args": ["--dir", "/var/lib/erisauth"],
  "environment": {},
  "timeout_secs": 30,
  "operations": {
    "approve": {
      "description": "Approve a pending pairing with the passphrase",
      "permission": "erisauth:approve",
      "request_schema": {
        "type": "object",
        "required": ["pairing", "granted", "identity", "passphrase"],
        "properties": {
          "pairing": {"type": "string", "format": "uuid"},
          "granted": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "identity": {
            "type": "object",
            "required": ["kind", "key"],
            "properties": {"kind": {"enum": ["iroh", "browser"]}, "key": {"type": "string", "minLength": 1, "maxLength": 128}},
            "additionalProperties": false
          },
          "passphrase": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "additionalProperties": false
      }
    },
    "passphrase": {
      "description": "Change the passphrase",
      "permission": "erisauth:passphrase",
      "request_schema": {
        "type": "object",
        "required": ["current", "new"],
        "properties": {
          "current": {"type": "string", "minLength": 1, "maxLength": 1024},
          "new": {"type": "string", "minLength": 8, "maxLength": 1024}
        },
        "additionalProperties": false
      }
    }
  }
}
